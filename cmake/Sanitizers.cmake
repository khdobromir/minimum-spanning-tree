add_library(mst_sanitizers INTERFACE)
if(MST_ASAN)
    target_compile_options(mst_sanitizers INTERFACE -fsanitize=address -fno-omit-frame-pointer)
    target_link_options(mst_sanitizers INTERFACE -fsanitize=address)
endif()
if(MST_UBSAN)
    target_compile_options(mst_sanitizers INTERFACE -fsanitize=undefined -fno-sanitize-recover=undefined)
    target_link_options(mst_sanitizers INTERFACE -fsanitize=undefined)
endif()
